# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/

# Ignore files created by MacOS
.DS_Store

# Photo originals (web-sized copies live in photos/gallery/)
photos/tomm photos/

# Working folder of every photo, renamed for review (not part of the site)
photos/all-named/

# Loose source uploads (web copies live in photos/selected/)
photos/*.jpg
!photos/selected/
